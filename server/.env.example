PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/banking-management
JWT_SECRET=change-this-to-a-long-random-string-of-32-plus-chars
# Must be replaced: server refuses to start with a short or placeholder secret.
MAX_DEPOSIT_AMOUNT=100000
MAX_TRANSACTION_AMOUNT=10000000
# Set to 1 when behind a reverse proxy
# TRUST_PROXY=1
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
MAX_PENDING_LOANS=3
